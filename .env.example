COMPOSE_PROJECT_NAME=momoshield

KAFKA_BOOTSTRAP=kafka:29092
SCHEMA_REGISTRY_URL=http://schema-registry:8081

KAFKA_TOPIC_RAW=transactions.raw
KAFKA_TOPIC_ALERTS=transactions.alerts
KAFKA_TOPIC_DLQ=transactions.dlq

MINIO_ROOT_USER=momoshield
MINIO_ROOT_PASSWORD=momoshield_dev_secret
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=momoshield

POSTGRES_USER=momoshield
POSTGRES_PASSWORD=momoshield_dev
POSTGRES_DB=momoshield
DATABASE_URL=postgresql://momoshield:momoshield_dev@postgres:5432/momoshield
POSTGRES_HOST_PORT=5433

BRONZE_DIR=/data/bronze
PRODUCER_RATE=500
# hybrid = Togo + PaySim (échantillon ou Kaggle) + scénarios MoMTSim — recommandé sans Kaggle
PRODUCER_MODE=hybrid
PAYSIM_ENRICH_TOGO=1
# Après make download-paysim :
# PAYSIM_CSV=data/paysim/PS_20174319_1491204399457.csv
# Kaggle API (ne pas commiter le token) :
# KAGGLE_API_TOKEN=KGAT_...
# ou fichier ~/.kaggle/access_token (chmod 600)