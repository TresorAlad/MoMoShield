FROM python:3.11-slim

WORKDIR /app
COPY pyproject.toml /app/
RUN pip install --no-cache-dir -e ".[producer]"

COPY momoshield /app/momoshield
COPY producer /app/producer
COPY streaming /app/streaming
COPY config /app/config

CMD ["python", "-m", "producer.main", "--mode", "hybrid", "--rate", "500"]